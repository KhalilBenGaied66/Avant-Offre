# Copy to .env (never commit it). Secrets only; everything else lives in config/*.yaml.
AVANT_OFFRE_MODE=sample
# LLM: none needed. Briefs are the deterministic template by default (brief.writer in
# config/settings.yaml); the fact extractor, and the brief writer when opted in, call a free local
# server (`make llm-local`); without a reachable model they fall back to deterministic output.
# Point the tasks at another endpoint without editing config/models.yaml:
# AVANT_OFFRE_LLM_API_BASE=https://llm.internal.example/v1
# Keys for managed providers, only if config/models.yaml uses them (or to compare them in the
# brief faithfulness eval):
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# Single API key for the HTTP API and the streamable-HTTP MCP transport.
AVANT_OFFRE_API_KEY=change-me
